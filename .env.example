# ── llm-balance-paraphraser — environment configuration ─────────────────────
# Copy this file to .env and adjust values for your setup.
# All variables are optional — defaults shown below.

# ── LLM Backends ─────────────────────────────────────────────────────────────
# Format: url|model|weight  (weight is relative, e.g. 2 = twice as much traffic)
# Multiple backends: comma-separated
LLM_BACKEND_STR=http://ollama:11434|llama3.2:3b|1
# LLM_BACKEND_STR=http://localhost:11434|llama3:8b|2,http://gpu2:11434|mistral:7b|1

# ── API Auth ──────────────────────────────────────────────────────────────────
# Leave blank to disable authentication (fine for local dev)
API_KEY=

# ── Budget Defaults ───────────────────────────────────────────────────────────
DEFAULT_MAX_WORDS=120
DEFAULT_MAX_TOKENS=200
DEFAULT_MODE=paraphrase

# ── Compression ───────────────────────────────────────────────────────────────
COMPRESSION_PASSES=2
HARD_TRUNCATE=true

# ── Health Checks ─────────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
BACKEND_TIMEOUT=60.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO, DEBUG

# ── CORS ─────────────────────────────────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:8000"]
